{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-weld-gamma-96.vercel.app/api/:path*"
    },
    {
      "source": "/((?!api/|.*\\..*).*)$",
      "destination": "/index.html"
    }
  ]
}
